# Telegram 공통 설정은 Stock Data Scraper > 설정에서 한 번 저장할 수 있습니다.
# 이 앱만 별도 환경변수로 덮어쓰려면 LIVE_TRADER_TELEGRAM_* 접두사를 사용합니다.
LIVE_TRADER_TELEGRAM_ENABLED=false
LIVE_TRADER_TELEGRAM_BOT_TOKEN=
LIVE_TRADER_TELEGRAM_CHAT_ID=
LIVE_TRADER_TELEGRAM_MIN_SEVERITY=info
LIVE_TRADER_TELEGRAM_TIMEOUT_SECONDS=5

# KIS overseas funding preference; does not enroll the broker service or enable orders.
KIS_OVERSEAS_FUNDING_MODE=INTEGRATED_MARGIN

# Unconfirmed public fee defaults, in percent (0.25 means 0.25%).
# Saving these estimates does not verify personal rates or enable orders.
# Minimum commission, taxes, automatic FX and settlement remain unknown.
